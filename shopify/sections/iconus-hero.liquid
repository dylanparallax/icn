<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono&display=swap" rel="stylesheet">

{%- liquid
  assign marquee_items = section.settings.marquee | newline_to_br | replace: '<br />', '|' | replace: '<br/>', '|' | replace: '<br>', '|' | split: '|'
  assign product_count = 0

  if section.settings.collection != blank
    assign product_count = section.settings.collection.products_count
  endif

  for block in section.blocks
    if block.type == 'product' and block.settings.product != blank
      assign product_count = product_count | plus: 1
    endif
  endfor
-%}

<section
  id="icn-hero-{{ section.id }}"
  class="icn-hero{% if section.settings.full_height %} icn-hero--full{% endif %}"
>
  <div class="icn-hero__body">
    <div class="icn-hero__copy">
      <h1 class="icn-hero__title">{{ section.settings.heading | newline_to_br }}</h1>

      <div class="icn-hero__details">
        {% if section.settings.text != blank %}
          <p class="icn-hero__text">{{ section.settings.text }}</p>
        {% endif %}

        <div class="icn-hero__actions">
          {% if section.settings.button_label != blank %}
            <a class="icn-hero__button icn-hero__button--teal" href="{{ section.settings.button_link }}">
              {{ section.settings.button_label }}
              <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
                <path d="M12.7494 12.7494V5.2506H5.2506M12.7494 5.2506L5.2506 12.7494" stroke="#342F29" stroke-width="1.5" stroke-linecap="round"/>
              </svg>
            </a>
          {% endif %}

          {% if section.settings.button_2_label != blank %}
            <a class="icn-hero__button icn-hero__button--ghost" href="{{ section.settings.button_2_link }}">
              {{ section.settings.button_2_label }}
              <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
                <path d="M12.7494 12.7494V5.2506H5.2506M12.7494 5.2506L5.2506 12.7494" stroke="#EBE5DD" stroke-width="1.5" stroke-linecap="round"/>
              </svg>
            </a>
          {% endif %}
        </div>
      </div>
    </div>

    <div class="icn-hero__media">
      {% if section.settings.image != blank %}
        {{
          section.settings.image
          | image_url: width: 1200
          | image_tag:
            class: 'icn-hero__image',
            widths: '400, 600, 800, 1200',
            sizes: '(min-width: 990px) 40vw, 100vw',
            alt: section.settings.image.alt
        }}
      {% else %}
        <div class="icn-hero__image-placeholder">
          Add the bust image in the theme editor
        </div>
      {% endif %}
    </div>
  </div>

  {% if product_count > 0 %}
    <div class="icn-hero__products" aria-label="Products">
      {% if section.settings.collection != blank %}
        {% for featured_product in section.settings.collection.products limit: section.settings.products_to_show %}
          <a class="icn-hero__card" href="{{ featured_product.url }}">
            {% if featured_product.featured_image != blank %}
              {{
                featured_product.featured_image
                | image_url: width: 160
                | image_tag:
                  class: 'icn-hero__card-image',
                  widths: '72, 144',
                  sizes: '72px',
                  alt: featured_product.featured_image.alt
              }}
            {% else %}
              <span class="icn-hero__card-image"></span>
            {% endif %}
            <span>
              <p class="icn-hero__card-title">{{ featured_product.title }}</p>
              <p class="icn-hero__card-price">{{ featured_product.price | money }}</p>
            </span>
            <span class="icn-hero__card-action">View</span>
          </a>
        {% endfor %}
      {% endif %}

      {% for block in section.blocks %}
        {% if block.type == 'product' and block.settings.product != blank %}
          {% assign featured_product = block.settings.product %}
          <a class="icn-hero__card" href="{{ featured_product.url }}" {{ block.shopify_attributes }}>
            {% if featured_product.featured_image != blank %}
              {{
                featured_product.featured_image
                | image_url: width: 160
                | image_tag:
                  class: 'icn-hero__card-image',
                  widths: '72, 144',
                  sizes: '72px',
                  alt: featured_product.featured_image.alt
              }}
            {% else %}
              <span class="icn-hero__card-image"></span>
            {% endif %}
            <span>
              <p class="icn-hero__card-title">{{ featured_product.title }}</p>
              <p class="icn-hero__card-price">{{ featured_product.price | money }}</p>
            </span>
            <span class="icn-hero__card-action">View</span>
          </a>
        {% endif %}
      {% endfor %}
    </div>
  {% endif %}

  {% if section.settings.show_marquee and marquee_items.size > 0 %}
    <div class="icn-hero__marquee-wrap">
      <ul class="icn-hero__sr-only">
        {% for item in marquee_items %}
          {% assign label = item | strip %}
          {% if label != blank %}
            <li>{{ label }}</li>
          {% endif %}
        {% endfor %}
      </ul>

      <div class="icn-hero__marquee" aria-hidden="true">
        {% for copy in (1..2) %}
          <div class="icn-hero__marquee-group">
            {% for item in marquee_items %}
              {% assign label = item | strip %}
              {% if label != blank %}
                <span class="icn-hero__marquee-item">{{ label }}</span>
                <span class="icn-hero__dot"></span>
              {% endif %}
            {% endfor %}
          </div>
        {% endfor %}
      </div>
    </div>
  {% endif %}
</section>

<style>
  #shopify-section-{{ section.id }} {
    --icn-cream: #ebe5dd;
    --icn-brown: #342f29;
    --icn-teal: #4ec1b4;
    --icn-teal-hover: #6dcec3;
    --icn-gold: #8a784a;
    --icn-stone: #bcb6ad;
    --icn-line: #5b554b;
  }

  #shopify-section-{{ section.id }} .icn-hero {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: var(--icn-brown);
    color: var(--icn-cream);
    font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
  }

  #shopify-section-{{ section.id }} .icn-hero--full {
    min-height: 100svh;
  }

  #shopify-section-{{ section.id }} .icn-hero__body {
    display: flex;
    flex: 1;
    flex-direction: column-reverse;
    gap: 1.5rem;
    min-height: 0;
    padding: 1.5rem 1.25rem 1rem;
  }

  #shopify-section-{{ section.id }} .icn-hero__copy {
    display: flex;
    width: 100%;
    max-width: 656px;
    flex-direction: column;
    justify-content: center;
    gap: 1.5rem;
  }

  #shopify-section-{{ section.id }} .icn-hero__title {
    margin: 0;
    font-size: clamp(2.25rem, min(10vw, 12vh), 7.5rem);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.02;
  }

  #shopify-section-{{ section.id }} .icn-hero__details {
    display: flex;
    max-width: 475px;
    flex-direction: column;
    gap: 1.5rem;
  }

  #shopify-section-{{ section.id }} .icn-hero__text {
    margin: 0;
    color: var(--icn-stone);
    font-size: 1rem;
    font-weight: 300;
    line-height: 1.6;
  }

  #shopify-section-{{ section.id }} .icn-hero__actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
  }

  #shopify-section-{{ section.id }} .icn-hero__button {
    display: inline-flex;
    height: 54px;
    flex-shrink: 0;
    align-items: center;
    gap: 1.5rem;
    border: 1px solid transparent;
    padding: 0 1.5rem;
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-size: 0.875rem;
    letter-spacing: 0.04em;
    line-height: 1;
    text-decoration: none;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .icn-hero__button--teal {
    background: var(--icn-teal);
    color: var(--icn-brown);
  }

  #shopify-section-{{ section.id }} .icn-hero__button--teal:hover {
    background: var(--icn-teal-hover);
  }

  #shopify-section-{{ section.id }} .icn-hero__button--ghost {
    border-color: var(--icn-line);
    background: transparent;
    color: var(--icn-cream);
  }

  #shopify-section-{{ section.id }} .icn-hero__button--ghost:hover {
    border-color: var(--icn-cream);
  }

  #shopify-section-{{ section.id }} .icn-hero__button:focus-visible,
  #shopify-section-{{ section.id }} .icn-hero__card:focus-visible {
    outline: 2px solid var(--icn-teal);
    outline-offset: 3px;
  }

  #shopify-section-{{ section.id }} .icn-hero__media {
    position: relative;
    width: 100%;
    min-height: 280px;
    flex: 1;
  }

  #shopify-section-{{ section.id }} .icn-hero__image,
  #shopify-section-{{ section.id }} .icn-hero__image-placeholder {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    width: auto;
    max-width: 100%;
    height: 100%;
    margin: 0 auto;
    object-fit: contain;
    object-position: bottom;
  }

  #shopify-section-{{ section.id }} .icn-hero__image-placeholder {
    display: grid;
    place-items: center;
    color: var(--icn-stone);
    font-size: 0.875rem;
  }

  #shopify-section-{{ section.id }} .icn-hero__products {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
    padding: 0 1.25rem 1.5rem;
  }

  #shopify-section-{{ section.id }} .icn-hero__card {
    display: grid;
    grid-template-columns: 72px 1fr auto;
    align-items: center;
    gap: 1rem;
    border-top: 1px solid var(--icn-line);
    padding-top: 0.75rem;
    color: inherit;
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .icn-hero__card-image {
    width: 72px;
    height: 72px;
    object-fit: cover;
    background: #2a2622;
  }

  #shopify-section-{{ section.id }} .icn-hero__card-title {
    margin: 0;
    font-size: 1rem;
    font-weight: 400;
  }

  #shopify-section-{{ section.id }} .icn-hero__card-price {
    margin: 0.25rem 0 0;
    color: var(--icn-stone);
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .icn-hero__card-action {
    color: var(--icn-teal);
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .icn-hero__marquee-wrap {
    overflow: hidden;
    border-top: 1px solid var(--icn-line);
  }

  #shopify-section-{{ section.id }} .icn-hero__marquee {
    display: flex;
    width: max-content;
    animation: icn-hero-marquee-{{ section.id }} 90s linear infinite;
  }

  #shopify-section-{{ section.id }} .icn-hero__marquee:hover {
    animation-play-state: paused;
  }

  #shopify-section-{{ section.id }} .icn-hero__marquee-group {
    display: flex;
    height: 84px;
    flex-shrink: 0;
    align-items: center;
  }

  #shopify-section-{{ section.id }} .icn-hero__marquee-item {
    padding: 0 2rem;
    color: var(--icn-stone);
    font-size: 1.125rem;
    font-weight: 300;
    white-space: nowrap;
  }

  #shopify-section-{{ section.id }} .icn-hero__dot {
    width: 6px;
    height: 6px;
    flex-shrink: 0;
    border-radius: 999px;
    background: var(--icn-gold);
  }

  #shopify-section-{{ section.id }} .icn-hero__sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @keyframes icn-hero-marquee-{{ section.id }} {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  @media (min-width: 640px) {
    #shopify-section-{{ section.id }} .icn-hero__body {
      gap: 2rem;
      padding: 2rem 2rem 1.5rem;
    }

    #shopify-section-{{ section.id }} .icn-hero__text {
      font-size: 1.125rem;
    }

    #shopify-section-{{ section.id }} .icn-hero__actions {
      flex-direction: row;
    }

    #shopify-section-{{ section.id }} .icn-hero__marquee-item {
      padding: 0 3rem;
      font-size: 1.5rem;
    }

    #shopify-section-{{ section.id }} .icn-hero__products {
      grid-template-columns: 1fr 1fr;
      padding: 0 2rem 2rem;
    }
  }

  @media (min-width: 990px) {
    #shopify-section-{{ section.id }} .icn-hero__body {
      flex-direction: row;
      align-items: stretch;
      gap: 2rem;
      padding: 1.5rem 2.5rem 1.5rem 4rem;
    }

    #shopify-section-{{ section.id }} .icn-hero__image,
    #shopify-section-{{ section.id }} .icn-hero__image-placeholder {
      right: 0;
      left: auto;
      margin: 0;
    }

    #shopify-section-{{ section.id }} .icn-hero__products {
      grid-template-columns: 1fr 1fr 1fr;
      padding: 0 2.5rem 2rem 4rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .icn-hero__marquee {
      animation: none;
    }
  }
</style>

{% schema %}
{
  "name": "ICONUS hero",
  "tag": "section",
  "class": "icn-hero-section",
  "settings": [
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Reveal what\nis possible."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Iconus genetic test kits uncover the biological blueprint within every patient, so you can chart a new path together."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "First button label",
      "default": "Explore test panels"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "First button link"
    },
    {
      "type": "text",
      "id": "button_2_label",
      "label": "Second button label",
      "default": "For patients"
    },
    {
      "type": "url",
      "id": "button_2_link",
      "label": "Second button link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Bust image"
    },
    {
      "type": "checkbox",
      "id": "full_height",
      "label": "Fill the screen",
      "default": true
    },
    {
      "type": "header",
      "content": "Products"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 1,
      "max": 12,
      "step": 1,
      "default": 3
    },
    {
      "type": "header",
      "content": "Ticker"
    },
    {
      "type": "checkbox",
      "id": "show_marquee",
      "label": "Show scrolling ticker",
      "default": true
    },
    {
      "type": "textarea",
      "id": "marquee",
      "label": "Ticker lines",
      "info": "Put each phrase on its own line.",
      "default": "Simple at-home cheek swab\nPanels chosen around specific goals\nResults for patient and provider\nKits shipped directly\nResults in about 3–4 weeks\nReviewed in a follow-up visit"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "ICONUS hero"
    }
  ]
}
{% endschema %}
